# Copy to .env.local and fill in values
DATABASE_URL=
# Optional Neon read replica for feed/search reads (falls back to DATABASE_URL)
# DATABASE_READ_URL=

JWT_SECRET=change-me-to-a-long-random-string

# Google Sign-In (OAuth 2.0 client IDs from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Redis (Upstash or managed Redis) — required for worker + realtime + feed cache
REDIS_URL=

# Background jobs (run apps/worker separately; no in-process cron in API)
CRON_INTERVAL_MS=60000
WORKER_HEALTH_PORT=3001

# Realtime WebSocket gateway (run apps/realtime separately)
REALTIME_PORT=3002

# Optional: Expo push API access token for higher rate limits
# EXPO_ACCESS_TOKEN=

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Expo Go redirect (must match Google Web client redirect URI)
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=https://auth.expo.io/@YOUR_EXPO_USERNAME/vaara-parents
# Use LAN IP on device, e.g. ws://192.168.1.10:3002/ws
EXPO_PUBLIC_REALTIME_URL=ws://localhost:3002/ws

# Feed cache TTL in seconds (default 120)
# FEED_CACHE_TTL_SECONDS=120

# Circle post media (AWS S3 uploads + CloudFront/custom CDN delivery)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
CDN_BASE_URL=https://media.example.com
# Optional for S3-compatible local/test storage:
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# App store update prompt (set when releasing a new build)
# APP_LATEST_VERSION=1.0.1
# APP_MINIMUM_VERSION=1.0.0
# APP_IOS_STORE_URL=https://apps.apple.com/app/idXXXXXXXXX
# APP_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.vaara.parents
