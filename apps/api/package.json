{
  "name": "@vaara/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./notifications": {
      "types": "./dist/services/notifications.d.ts",
      "import": "./dist/services/notifications.js",
      "default": "./dist/services/notifications.js"
    },
    "./topics": {
      "types": "./dist/lib/topics.d.ts",
      "import": "./dist/lib/topics.js",
      "default": "./dist/lib/topics.js"
    },
    "./auth": {
      "types": "./dist/lib/jwt.d.ts",
      "import": "./dist/lib/jwt.js",
      "default": "./dist/lib/jwt.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "test:audit": "RUN_E2E_AUDIT=1 tsx --test test/e2e-audit.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/s3-request-presigner": "^3.1118.0",
    "@hono/node-server": "^1.13.7",
    "@vaara/db": "*",
    "@vaara/redis": "*",
    "@vaara/shared": "*",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "google-auth-library": "^9.15.1",
    "hono": "^4.6.14",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
