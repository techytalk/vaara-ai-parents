{
  "expo": {
    "name": "Vaara Parents",
    "slug": "vaara-parents",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vaara-parents",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#0E9A8A"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFCF7"
    },
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.vaara.parents",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash-icon.png",
        "backgroundColor": "#FFFCF7"
      },
      "package": "com.vaara.parents"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0E9A8A",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true,
          "mode": "production"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFCF7"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Vaara Parents to select photos and videos for circle posts."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.375946640576-8eiut23u8r6kgpd460m19c5lh42ai9am"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "iosStoreUrl": "https://apps.apple.com/app/vaara-parents",
      "androidStoreUrl": "https://play.google.com/store/apps/details?id=com.vaara.parents",
      "googleWebClientId": "375946640576-8eiut23u8r6kgpd460m19c5lh42ai9am.apps.googleusercontent.com"
    }
  }
}
