{
  "expo": {
    "name": "Vaara Parents",
    "slug": "vaara-parents",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/0cc4bc43-2bbe-410b-8cba-68ab1bc2bc21"
    },
    "orientation": "portrait",
    "scheme": "vaara-parents",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#0E9A8A"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFCF7"
    },
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.vaara.parents",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": ["applinks:vaara.ai", "applinks:www.vaara.ai"],
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash-icon.png",
        "backgroundColor": "#FFFCF7"
      },
      "package": "com.vaara.parents",
      "versionCode": 12,
      "permissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "vaara.ai",
              "pathPrefix": "/p"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0E9A8A",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true,
          "mode": "production"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFCF7"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Vaara Parents to select photos and videos for circle posts."
        }
      ],
      "expo-document-picker",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.375946640576-bcoc1nonnurepmvq6ebnm0smfhnao0ol"
        }
      ],
      "@react-native-firebase/app"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "iosStoreUrl": "https://apps.apple.com/app/vaara-parents",
      "androidStoreUrl": "https://play.google.com/store/apps/details?id=com.vaara.parents",
      "googleWebClientId": "375946640576-8eiut23u8r6kgpd460m19c5lh42ai9am.apps.googleusercontent.com",
      "googleIosClientId": "375946640576-bcoc1nonnurepmvq6ebnm0smfhnao0ol.apps.googleusercontent.com"
    }
  }
}
