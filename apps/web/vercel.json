{
  "installCommand": "cd ../.. && rm -rf node_modules && npm install --include=optional --foreground-scripts",
  "buildCommand": "cd ../.. && npm run build:web",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/admin", "destination": "/internal/admin/", "permanent": false },
    { "source": "/admin/", "destination": "/internal/admin/", "permanent": false },
    { "source": "/admin/schools.html", "destination": "/internal/admin/schools.html", "permanent": false },
    { "source": "/admin/qr.html", "destination": "/internal/admin/qr.html", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/p/:shareId",
      "destination": "https://api.vaara.ai/v1/shares/:shareId/page"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ]
}
